[Unit]
Description=DE0-CV FPGA Chess over Raspberry Pi SPI
After=network.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
SupplementaryGroups=spi
WorkingDirectory="@ROOT@"
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CHESS_SPI_SPEED=1000000
ExecStart="@ROOT@/.venv/bin/python" "@ROOT@/run.py" serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
